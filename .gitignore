###################
# Go (API and TUI folders)
###################

# Binaries for programs and plugins
api/*.exe
api/*.exe~
api/*.dll
api/*.so
api/*.dylib
api/api
api/main

tui/*.exe
tui/*.exe~
tui/*.dll
tui/*.so
tui/*.dylib
tui/tui
tui/main

# Test binary, built with `go test -c`
api/*.test
tui/*.test

# Output of the go coverage tool
api/*.out
api/coverage.txt
api/coverage.html
tui/*.out
tui/coverage.txt
tui/coverage.html

# Dependency directories
api/vendor/
tui/vendor/

# Go workspace file
go.work
go.work.sum

# Air live reload (if using)
api/tmp/
tui/tmp/

# Build directories
api/bin/
api/build/
tui/bin/
tui/build/

# SSH keys and config (TUI folder)
tui/.ssh/

# Database files (if any)
*.db
*.sqlite
*.sqlite3

# Compiled Object files, Static and Dynamic libs
*.o
*.a

# Architecture specific extensions/prefixes
*.[568vq]
[568vq].out

# cgo generated files
_cgo_*
_cgo_export.*

# Debug files
*.dSYM/
*.pdb