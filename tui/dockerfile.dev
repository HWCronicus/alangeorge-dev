FROM golang:1.25.4-alpine

# Install necessary packages for development
RUN apk --no-cache add ca-certificates git openssh-keygen ncurses-terminfo-base

WORKDIR /app

# Set environment variables
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# Copy go mod files first for better caching
COPY go.mod go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code and assets
COPY . .

EXPOSE 42069

# Generate SSH key and run
CMD ["sh", "-c", "mkdir -p .ssh && (test -f .ssh/id_ed25519 || ssh-keygen -t ed25519 -f .ssh/id_ed25519 -N '') && go run ."]
