{
  "name": "alangeorge-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker-compose -f docker-compose.dev.yml up",
    "dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "dev:down": "docker-compose -f docker-compose.dev.yml down",
    "dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "dev:restart": "docker-compose -f docker-compose.dev.yml restart",
    "build": "docker-compose build",
    "up": "docker-compose up",
    "up:build": "docker-compose up --build",
    "down": "docker-compose down",
    "logs": "docker-compose logs -f",
    "restart": "docker-compose restart",
    "clean": "docker-compose down -v && docker-compose -f docker-compose.dev.yml down -v"
  }
}
