FROM oven/bun:1-alpine

# Install necessary packages
RUN apk --no-cache add git

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./
COPY bun.lockb* ./

# Install dependencies
RUN bun install

# Copy source code
COPY . .

EXPOSE 5173

# Run Vite dev server
CMD ["bun", "run", "dev", "--host", "0.0.0.0"]
